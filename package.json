{
  "name": "dsh-fs-browser",
  "version": "0.1.0",
  "description": "DSH workspace file browser: an embedded right-side file column sharing the frame with the conversation — file list, Shiki-powered text preview with line numbers, image preview, copy-on-select, and per-workspace remembered state.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build:host": "cp src/index.js lib/index.js",
    "build:client": "tsdown -c tsdown.config.ts",
    "build": "pnpm build:host && pnpm build:client",
    "pack": "pnpm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "^0.0.1-rc.1",
    "react": "^18",
    "zod": "^4"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.3.1",
    "react": "^18.2.0",
    "shiki": "^4.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "file-browser",
    "workspace"
  ]
}